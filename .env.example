# BMIP environment (subset W1-B). Copy to .env via `make secrets`.
# Never commit .env. Values below are placeholders, not real credentials.

BMIP_ENV=dev
BMIP_NODE=n1
BMIP_LOG_LEVEL=INFO

# MinIO / S3 (root credentials, dev only)
MINIO_ROOT_USER=bmipadmin
MINIO_ROOT_PASSWORD=change-me
MINIO_ENDPOINT=http://localhost:9000
MINIO_ENDPOINT_INTERNAL=http://minio:9000
MINIO_ENDPOINT_LAKEKEEPER=http://minio:9000
MINIO_S3_REGION=local

# Per-service MinIO users (created by `make bootstrap`)
MINIO_SVC_INGEST_ACCESS_KEY=svc-ingest
MINIO_SVC_INGEST_SECRET_KEY=change-me
MINIO_SVC_PROCESS_ACCESS_KEY=svc-process
MINIO_SVC_PROCESS_SECRET_KEY=change-me
MINIO_SVC_DBT_ACCESS_KEY=svc-dbt
MINIO_SVC_DBT_SECRET_KEY=change-me
MINIO_SVC_ML_ACCESS_KEY=svc-ml
MINIO_SVC_ML_SECRET_KEY=change-me
MINIO_SVC_API_ACCESS_KEY=svc-api
MINIO_SVC_API_SECRET_KEY=change-me
MINIO_SVC_BACKUP_ACCESS_KEY=svc-backup
MINIO_SVC_BACKUP_SECRET_KEY=change-me
MINIO_SVC_DOCS_ACCESS_KEY=svc-docs
MINIO_SVC_DOCS_SECRET_KEY=change-me

# Iceberg REST catalog
LAKEKEEPER_URL=http://localhost:8181
LAKEKEEPER_URL_INTERNAL=http://lakekeeper:8181
LAKEKEEPER_WAREHOUSE=lakehouse
LAKEKEEPER_DB_NAME=lakekeeper
LAKEKEEPER_DB_USER=lakekeeper
LAKEKEEPER_DB_PASSWORD=change-me
LAKEKEEPER_PG_ENCRYPTION_KEY=change-me

# PostgreSQL core
POSTGRES_USER=bmip
POSTGRES_PASSWORD=change-me
POSTGRES_DB=bmip
POSTGRES_CORE_DSN=postgresql://bmip:change-me@localhost:5433/bmip

# Prefect orchestration
PREFECT_API_URL=http://localhost:4200/api
PREFECT_DB_USER=prefect
PREFECT_DB_PASSWORD=change-me
PREFECT_DB_NAME=prefect
PREFECT_WORK_POOL=local-process
PREFECT_WORK_QUEUE=default

# Redpanda
REDPANDA_BROKERS=localhost:19092
REDPANDA_BROKERS_INTERNAL=redpanda:9092
MARKET_TOPIC=market.trades
MARKET_DLQ_TOPIC=market.trades.dlq

# Stream processor (W1-B)
STREAM_CONSUMER_GROUP=ohlcv-builder
STREAM_REPLAY_GROUP=ohlcv-builder-replay
STREAM_POLL_MAX_RECORDS=1000
STREAM_POLL_TIMEOUT_MS=500
STREAM_WATERMARK_DELAY_SECONDS=120
STREAM_CORRECTION_WINDOW_MINUTES=30
STREAM_METRICS_HOST=0.0.0.0
STREAM_METRICS_PORT=9101
STREAM_IDLE_EXIT_SECONDS=5
STREAM_STARTUP_DELAY_SECONDS=0

# Market source
MARKET_SYMBOL=BTCUSDT
MARKET_FEED=binance_ws
MARKET_WS_URL=wss://stream.binance.com:9443/ws
MARKET_REPLAY_FILE=tests/fixtures/binance_agg_trades.jsonl
BINANCE_VISION_BASE_URL=https://data.binance.vision

# Social source
SOCIAL_FEED=bluesky
SOCIAL_QUERY=bitcoin OR btc OR crypto
SOCIAL_MAX_PAGES=50
SOCIAL_REPLAY_FILE=tests/fixtures/bluesky_posts.json
BLUESKY_BASE_URL=https://api.bsky.app

# Hashing salts (fill local values, never commit)
PII_HASH_SALT=change-me
BMIP_API_KEY_HASH_SALT=change-me

# Retention
RETENTION_BRONZE_DAYS=14
RETENTION_SILVER_DAYS=30
RETENTION_GOLD_DAYS=90
