# BMIP environment (subset W1-A). Copy to .env and fill local values.
# Never commit .env. Values below are examples, not real credentials.

BMIP_ENV=dev
BMIP_NODE=n1
BMIP_LOG_LEVEL=INFO

# MinIO / S3
MINIO_ENDPOINT=http://minio:9000
MINIO_ROOT_USER=bmipadmin
MINIO_ROOT_PASSWORD=change-me
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me

# Iceberg REST catalog
LAKEKEEPER_URL=http://lakekeeper:8181
LAKEKEEPER_WAREHOUSE=lakehouse

# PostgreSQL core
POSTGRES_CORE_DSN=postgresql://bmip:change-me@postgres-core:5432/bmip

# Redpanda
REDPANDA_BROKERS=redpanda:9092
MARKET_TOPIC=market.trades

# Market source
MARKET_SYMBOL=BTCUSDT
MARKET_FEED=binance_ws

# Social source
SOCIAL_FEED=bluesky
SOCIAL_QUERY=bitcoin OR btc OR crypto
SOCIAL_MAX_PAGES=50

# Hashing salts (fill local values, never commit)
PII_HASH_SALT=change-me
BMIP_API_KEY_HASH_SALT=change-me

# Retention
RETENTION_BRONZE_DAYS=14
RETENTION_SILVER_DAYS=30
RETENTION_GOLD_DAYS=90
