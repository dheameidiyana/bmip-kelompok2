# Dummy values for CI config validation only. Never use these locally.
BMIP_ENV=ci
BMIP_NODE=ci
BMIP_LOG_LEVEL=INFO

MINIO_ROOT_USER=bmipadmin
MINIO_ROOT_PASSWORD=ci-not-a-secret
MINIO_ENDPOINT=http://localhost:9000
MINIO_ENDPOINT_INTERNAL=http://minio:9000
MINIO_ENDPOINT_LAKEKEEPER=http://minio:9000
MINIO_S3_REGION=local

MINIO_SVC_INGEST_ACCESS_KEY=svc-ingest
MINIO_SVC_INGEST_SECRET_KEY=ci-not-a-secret
MINIO_SVC_PROCESS_ACCESS_KEY=svc-process
MINIO_SVC_PROCESS_SECRET_KEY=ci-not-a-secret
MINIO_SVC_DBT_ACCESS_KEY=svc-dbt
MINIO_SVC_DBT_SECRET_KEY=ci-not-a-secret
MINIO_SVC_ML_ACCESS_KEY=svc-ml
MINIO_SVC_ML_SECRET_KEY=ci-not-a-secret
MINIO_SVC_API_ACCESS_KEY=svc-api
MINIO_SVC_API_SECRET_KEY=ci-not-a-secret
MINIO_SVC_BACKUP_ACCESS_KEY=svc-backup
MINIO_SVC_BACKUP_SECRET_KEY=ci-not-a-secret
MINIO_SVC_DOCS_ACCESS_KEY=svc-docs
MINIO_SVC_DOCS_SECRET_KEY=ci-not-a-secret

LAKEKEEPER_URL=http://localhost:8181
LAKEKEEPER_URL_INTERNAL=http://lakekeeper:8181
LAKEKEEPER_WAREHOUSE=lakehouse
LAKEKEEPER_DB_NAME=lakekeeper
LAKEKEEPER_DB_USER=lakekeeper
LAKEKEEPER_DB_PASSWORD=ci-not-a-secret
