POSTGRES_USER=bmip
POSTGRES_PASSWORD=ci-not-a-secret
POSTGRES_DB=bmip
POSTGRES_CORE_DSN=postgresql://bmip:ci-not-a-secret@localhost:5433/bmip

PREFECT_API_URL=http://localhost:4200/api
PREFECT_DB_USER=prefect
PREFECT_DB_PASSWORD=ci-not-a-secret
PREFECT_DB_NAME=prefect
PREFECT_WORK_POOL=local-process
PREFECT_WORK_QUEUE=default

REDPANDA_BROKERS=localhost:19092
REDPANDA_BROKERS_INTERNAL=redpanda:9092
MARKET_TOPIC=market.trades
MARKET_DLQ_TOPIC=market.trades.dlq
STREAM_CONSUMER_GROUP=ohlcv-builder
STREAM_REPLAY_GROUP=ohlcv-builder-replay
STREAM_POLL_MAX_RECORDS=1000
STREAM_POLL_TIMEOUT_MS=500
STREAM_WATERMARK_DELAY_SECONDS=120
STREAM_CORRECTION_WINDOW_MINUTES=30
STREAM_METRICS_HOST=0.0.0.0
STREAM_METRICS_PORT=9101
STREAM_IDLE_EXIT_SECONDS=5
STREAM_STARTUP_DELAY_SECONDS=0
MARKET_SYMBOL=BTCUSDT
MARKET_FEED=binance_ws
SOCIAL_FEED=bluesky
SOCIAL_QUERY=bitcoin OR btc OR crypto
SOCIAL_MAX_PAGES=50

PII_HASH_SALT=ci-not-a-secret
BMIP_API_KEY_HASH_SALT=ci-not-a-secret

RETENTION_BRONZE_DAYS=14
RETENTION_SILVER_DAYS=30
RETENTION_GOLD_DAYS=90
