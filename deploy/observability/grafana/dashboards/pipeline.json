{
  "uid": "bmip-pipeline",
  "title": "BMIP - Pipeline",
  "tags": [
    "bmip",
    "w2-b",
    "pipeline"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Freshness (seconds)",
      "description": "Age of the newest row per layer. Silver comes from the stream processor, gold from the last publish, serving from the API.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "bmip_freshness_seconds",
          "legendFormat": "{{layer}} | {{dataset}} | {{job}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Consumer lag",
      "description": "Sum of partition lag for the stream consumer group.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "bmip_consumer_lag{job!=\"drill\"}",
          "legendFormat": "lag"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Batch duration",
      "description": "How long the last gold and quality runs took.",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "bmip_batch_duration_seconds",
          "legendFormat": "{{job}} ({{status}})"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "DQ failures (last run)",
      "description": "Critical failures block the publish; warnings are recorded only.",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "bmip_dq_failures_total{scope!=\"drill\"}",
          "legendFormat": "{{severity}} | {{scope}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "bargauge",
      "title": "Gold rows",
      "description": "Rows published per mart in the last run.",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "displayMode": "gradient"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "bmip_gold_rows",
          "legendFormat": "{{table}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Scrape targets up",
      "description": "One tile per Prometheus target. A red tile is a down target.",
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 15
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up",
          "legendFormat": "{{job}}"
        }
      ]
    }
  ]
}
